{
  "name": "tutu-pet",
  "productName": "兔兔",
  "version": "1.0.0",
  "description": "兔兔 - 可爱的2D卡通桌宠",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.tutu.pet",
    "productName": "兔兔",
    "icon": "icon.ico",
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "bubble.json",
      "icon.ico",
      "icon.png",
      "assets/transparent/**",
      "assets/frames/**"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "icon.ico"
    },
    "portable": {
      "artifactName": "兔兔.exe",
      "unpackDirName": "tutu-pet"
    },
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    }
  }
}
